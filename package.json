{
  "name": "lane-router",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "lane-router-accounts": "dist/accounts/main.js",
    "lane-router-accounts-supervisor": "dist/accounts/supervisor.js",
    "lane-router-codex": "dist/process/codex-launcher.js",
    "lane-router-lane": "dist/process/lane-launcher.js",
    "lane-router-restore-project": "dist/process/project-restore-cli.js",
    "lane-router-rotate": "dist/process/rotation-launcher.js",
    "lane-router-zcode": "dist/mcp/zcode-lane-mcp-server.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs && npm run build:graphs",
    "build:graphs": "tsc -p tsconfig.graphs.json && vite build --config vite.graphs.config.ts && node scripts/graph-assets.mjs",
    "test:graph-browser": "node tests/graph-browser.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.graphs.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@xyflow/react": "12.12.0",
    "better-sqlite3": "13.0.3",
    "d3-force": "3.0.0",
    "markdown-it": "15.0.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "ws": "8.21.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/d3-force": "3.0.10",
    "@types/node": "22.20.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "happy-dom": "^20.12.0",
    "tsx": "4.23.9",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "4.1.10"
  }
}
